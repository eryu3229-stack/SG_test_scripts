# ============================================================
# SG_test_scripts .gitignore
# 原则：只跟踪「程序本体」—— run_scripts/ 直接运行所需的源码与配置。
#       输出产物、下载资料、编辑器/系统杂项、开发自检脚本 一律不入库。
# ============================================================

# ---------- 测试结果输出（所有 run_scripts 的产物）----------
output/

# ---------- 噪声曲线数据（wideband.py 生成）----------
noise_curve_data.csv
noise_only_curve.png
noise_*.png

# ---------- Excel 产物（新规范只出 CSV，*.xlsx 为历史遗留）----------
*.xlsx

# ---------- 压缩文件 ----------
*.zip

# ---------- 下载的仪器手册 / 参考资料（约 49 MB，非源码）----------
.workbuddy/library/

# ---------- 项目记忆与工作日志（本地资料）----------
.workbuddy/memory/

# ---------- 开发期自检 / 回归脚本（本地保留，不入库）----------
wb_*.py

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.code-workspace

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 编辑器临时 / 交换文件 ----------
*.swp
*.swo
*~
*.bak
*.tmp

# ---------- Python 虚拟环境 / 构建产物 ----------
venv/
.venv/
env/
build/
dist/
*.egg-info/

# ---------- Python 缓存 ----------
__pycache__/
*.pyc

# ---------- 工具缓存 / 覆盖率 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- 环境文件 ----------
.env

# ---------- 日志 ----------
*.log

# ---------- Windows 保留设备名 ----------
nul
