      function validateEmail(email) {
        var re =
          /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        return re.test(email);
      };
  
      function goToNextStep() {
		_edbg && console.log("FUNC CALLED : goToNextStep()");

        $(".error-text").text("").hide()
        $(".field-label").removeClass("form_error");
  
        var strRequiredField = $("#spnRequiredField").text();
        var strInvalidEmail = $("#spnInvalidEmail").text();
  
        var isFormValid = true;
  
        if ( $("#field00").val().trim().length == 0 ) {
          $("#field00").siblings(".error-text").text(strRequiredField).show()
                       .siblings(".field-label").addClass("form_error")
                       .css("border-color", "red");
          isFormValid = false;
        }
        if ( validateEmail($("#field00").val().trim()) == false ) {
          $("#field00").siblings(".error-text").text(strInvalidEmail).show()
                       .siblings(".field-label").addClass("form_error")
                       .css("border-color", "red");
          isFormValid = false;
        }
        
        if (isFormValid) {
        	setElqDataLookup('CheckContactByEmailEntered');
        }        
      }
      
      function validate_form() { 
        _edbg && console.log("FUNC CALLED : validate_form()");

        //reset form validation checks
        $(".error-text").text("").hide()
        $(".field-label").removeClass("form_error");
        
        // Put default  form error class for lblFormValidationCheck
      	$("#lblFormValidationCheck").addClass("form_error");
  
        var strRequiredField = $("#spnRequiredField").text();
        var strInvalidEmail = $("#spnInvalidEmail").text();
  
        var isFormValid = true;
  
        if ( $("#field00").val().trim().length == 0 ) {
          $("#field00").siblings(".error-text").text(strRequiredField).show()
                       .siblings(".field-label").addClass("form_error")
                       .css("border-color", "red");
          isFormValid = false;
        }
        if ( $("#field01").val().trim().length == 0 ) {
          $("#field01").siblings(".error-text").text(strRequiredField).show()
                       .siblings(".field-label").addClass("form_error")
                       .css("border-color", "red");
          isFormValid = false;
        }
        if ( $("#field02").val().trim().length == 0 ) {
          $("#field02").siblings(".error-text").text(strRequiredField).show()
                        .siblings(".field-label").addClass("form_error")
                        .css("border-color", "red");
          isFormValid = false;
        }
        if ( $("#field04").val().trim().length == 0 ) {
          $("#field04").siblings(".error-text").text(strRequiredField).show()
                        .siblings(".field-label").addClass("form_error")
                        .css("border-color", "red");
          isFormValid = false;
        }
  
        if (!isFormValid) return isFormValid; //exit if form validation fails
  
        // Set return url field
        var url = window.location.href;
        if ( !( url.includes("?success=true") || url.includes("&success=true") ) ) {
          url.includes("?") ? url+="&success=true" : url+="?success=true";
        }
        $("#r_url").val(url);
  
        // isFormValid = true;  // set true to check if cookie is updated ??
        /*if ( isFormValid && ( profileEmailElq.length>0 && profileEmailElq!=$("#field00").val().trim()) ) {
          
          	//document.cookie="ELOQUA=;expires=Thu; 01 Jan 1970;domain=.keysight.com;path=/";
        	//_elqQ.push(['elqVisitorGuid'," "]);
          	//_elqQ.push(['elqTrackPageView']);
            //_elqQ.push(['elqUseFirstPartyCookie', '']);
            //_elqQ.push(['elqVisitorGuid'," "]);
          	//_elqQ.push(['elqTrackPageView']);
        }*/
        
        if ( isFormValid ) {
        	// Remove form error class for lblFormValidationCheck when for above  validation check pass 
      		$("#lblFormValidationCheck").removeClass("form_error");
        
      		var nowDate = new Date(); $("#hidfield34").val($("#field00").val() + "__" + nowDate.getFullYear()+'-'+(nowDate.getMonth()+1)+'-'+nowDate.getDate() + "__" + document.URL);
          console.log($("#hidfield34").val());
        
        	if ( $("#field13").prop("checked") ) {
              setKcomRememberMeCookie();
            }
        }
  
        return isFormValid;
      }
      
       function setKcomRememberMeCookie() {
        _edbg && console.log("FUNC CALLED : setKcomRememberMeCookie()");
        

        var strFirstName 	= $('input[name="firstName"]').val();
        var strLastName 	= $('input[name="lastName"]').val();
        var strEmailAddress = $('input[name="emailAddress"]').val();
        
        var host = window.location.host;
        var strRememberMeAPIEndpoint = "https://"+host+"/etc/keysight/api/UpdateFormCookie"; 
        //var strRememberMeCookieName = _eUF.getCookieVal('AGREMMEADV');
         
         $.ajax({
           type: "POST",
           async: false,
           url: strRememberMeAPIEndpoint,
           data: { FirstGivenName: strFirstName, LastName: strLastName, EmailAddress: strEmailAddress },
           success: function (response) {
             console.log("RememberMeAPI Post Success : \n" + response);
             _eUF.createCookie("AGREMMEADV", response, 365);
           },
           error: function (error) {
             console.log("RememberMeAPI Post Error :" + error);
           }
         });

       }
      
	/*if (window.attachEvent) {window.attachEvent('onload', setFormDisplayOnWindowLoad);}
        else if (window.addEventListener) {window.addEventListener('load', setFormDisplayOnWindowLoad, false);}
        else {document.addEventListener('load', setFormDisplayOnWindowLoad, false);}*/
      
      if (window.addEventListener) {
        // For all major browsers, except IE 8 and earlier
        window.addEventListener('DOMContentLoaded', setFormDisplayOnWindowLoad, false);
      } else if (window.attachEvent) {
        // For IE 8 and earlier versions
        window.attachEvent('onload', setFormDisplayOnWindowLoad);
      }      

      function setFormDisplayOnWindowLoad() {

            _edbg && console.log("FUNC CALLED : window.onload()");

            var isChrome = !!window.chrome && (!!window.chrome.webstore || !!window.chrome.runtime);      
            //Override values as per prod/staging settings
            $("#frmELQ").attr("action", ( isChrome ? EloquaFormPostURL2: EloquaFormPostURL) );
		$('input[name="elqFormName"]').val(EloquaFormName);
        $('input[name="elqSiteId"]').val(EloquaSiteID);

		setElqDataLookup('CheckVisitor');      
        
        fSetUData();
      	redirect_to_assets();
  
      };
      
      function redirect_to_assets() {
        _edbg && console.log("FUNC CALLED : redirect_to_assets()");

        var url = window.location.href;
        var docUrl = document.getElementById('doc_Url').value;

        if ((url.indexOf('?' + 'success=true') !== -1) || (url.indexOf('&' + 'success=true') !== -1)) {
          document.getElementById('body_lookup').style.display = 'block';
          document.getElementById('form_body').style.display = 'none';
          document.getElementById('ty_div').style.display = 'block';

          if (docUrl !== '') {
            setTimeout(function () {
              window.top.location = docUrl;
            }, 2000);
          };
        };
      };
      
    </script>
    <script>
      
      function fSetUData(){ var isOpera=(!!window.opr && !!opr.addons) || !!window.opera || navigator.userAgent.indexOf(' OPR/') >=0; var isFirefox=typeof InstallTrigger !=='undefined'; var isSafari=/constructor/i.test(window.HTMLElement) || (function (p){ return p.toString()==="[object SafariRemoteNotification]";})(!window['safari'] || (typeof safari !=='undefined' && safari.pushNotification)); var isIE=false || !!document.documentMode; var isEdge=!isIE && !!window.StyleMedia; var isChrome=!!window.chrome && (!!window.chrome.webstore || !!window.chrome.runtime); var isEdgeChromium=isChrome && (navigator.userAgent.indexOf("Edg") !=-1); var isBlink=(isChrome || isOpera) && !!window.CSS; var vBrowser="Browser:Other"; if(isBlink){vBrowser="Browser:Blink"} if(isEdgeChromium){vBrowser="Browser:EdgeChromium"} if(isFirefox){vBrowser="Browser:FireFox"} if(isSafari){vBrowser="Browser:Safari"} if(isIE){vBrowser="Browser:IE"} if(isEdge){vBrowser="Browser:Edge"} if(isChrome){vBrowser="Browser:Chrome"} $("#hidfield33").val(vBrowser+";");}
  
