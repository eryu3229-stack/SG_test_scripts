      var fields_form = ['epp0', 'epp1', 'epp2', 'epp4', 'epp12'];
      var fields_id_form = ['field00', 'field01', 'field02', 'field04', 'field12'];
  
      var profileEmailElq = "";
      var elqState = "";
      var formState = "";
      var elqtimeoutHandle;
      var timerMs = 3000;
      var autoFormSubmit = true; 
      var isCheckKcomCookies = true; 
      
      
      if ((_eFURL.indexOf('?' + 'afs=true') !== -1) || (_eFURL.indexOf('&' + 'afs=true') !== -1)) { autoFormSubmit = true;}
      if ((_eFURL.indexOf('?' + 'afs=false') !== -1) || (_eFURL.indexOf('&' + 'afs=false') !== -1)) { autoFormSubmit = false;}
