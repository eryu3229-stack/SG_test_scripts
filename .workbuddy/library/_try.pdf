      function SetElqContent()
      {
        _edbg && console.log("FUNC CALLED : SetElqContent()");

        _edbg && console.log("formState: " + formState + "; SetElqContent Called -> this.GetElqContentPersonalizationValue:" + this.GetElqContentPersonalizationValue);
        _edbg && console.log("GetElqContentPersonalizationValue(VisitorUniqueField)" + GetElqContentPersonalizationValue(VisitorUniqueField));
              
        if ( (formState == '' ||formState == 'S00')  && this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(VisitorUniqueField) != "" ) {
          _edbg && console.log("formState = '' or 'S00'   && visitor found");  
          setElqDataLookup('CheckContactByElqEmail');
        }
  
        if ( this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(ContactUniqueField) != "" ) {
          _edbg && console.log("default : contact email found ");
          loadElqContactData();
        }
  
        /*if ( formState == 'S10'  && this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(ContactUniqueField) != "" ) {
          _edbg && console.log("formState == 'S10' && contact email found "); loadElqContactData();
        }
        if ( formState == 'S20' && this.GetElqContentPersonalizationValue && GetElqContentPersonalizationValue(ContactUniqueField) != "" ) {
          _edbg && console.log("formState == 'S20' && contact email found "); loadElqContactData();
        }*/
  
      }
      
      function setElqDataLookup(pLookupState) {
        _edbg && console.log("FUNC CALLED : setElqDataLookup(pLookupState)");
        
        if (pLookupState == 'CheckVisitor') {
            _edbg && console.log("pLookupState:"+pLookupState);
          	// first call on window load
  
            _elqQ.push(['elqUseFirstPartyCookie', FirstPartyCookieDomain]);
            _edbg && console.log("elqDataLookup escape(LookupIdVisitor) : " + escape(LookupIdVisitor) );
            _elqQ.push(['elqDataLookup', escape(LookupIdVisitor),'']);
            
            formState = 'S00';
            resetFormDisplay();
            elqtimeoutHandle = setTimeout('checkKcomCookies()', timerMs);
        }
        else if (pLookupState == 'CheckContactByElqEmail') {
            _edbg && console.log("pLookupState:"+pLookupState);
          
            // Look for contact by ELQ received visitor email
            _edbg && console.log("elqDataLookup escape(LookupIdVisitor) : " + escape(LookupIdVisitor) + ' , <' + ContactUniqueField + '>' + GetElqContentPersonalizationValue(VisitorUniqueField) + '</' + ContactUniqueField + '>' );
            _elqQ.push(['elqDataLookup', 
                escape(LookupIdContact), 
                '<' + ContactUniqueField + '>' + GetElqContentPersonalizationValue(VisitorUniqueField) + '</' + ContactUniqueField + '>'
                ]);
            
            formState = 'S10';
            window.clearTimeout(elqtimeoutHandle);
            resetFormDisplay();
            elqtimeoutHandle = setTimeout('setFormDisplay()', timerMs);
        }
        else if (pLookupState == 'CheckContactByEmailEntered') {
            _edbg && console.log("pLookupState:"+pLookupState);

          // Show email editable & continue without Change Email
            var visitorEmail = $("#field00").val();
            if (validateEmail(visitorEmail) ) {
              _edbg && console.log("elqDataLookup escape(LookupIdVisitor) : " + escape(LookupIdVisitor) + ' , <' + ContactUniqueField + '>' + visitorEmail + '</' + ContactUniqueField + '>' );
              _elqQ.push(['elqDataLookup', 
                            escape(LookupIdContact), 
                            '<' + ContactUniqueField + '>' + visitorEmail + '</' + ContactUniqueField + '>'
                ]);
              formState = 'S20';
              window.clearTimeout(elqtimeoutHandle);
              resetFormDisplay();
              elqtimeoutHandle = setTimeout('setFormDisplay()', timerMs);
            } else {
              //resetFormDisplay()
              //setFormDisplay();
            }
        }
      }
  
      function checkKcomCookies() {
        _edbg && console.log("FUNC CALLED : checkKcomCookies()");
        // Put Remember Me Cookie & Call API
        // If Remember Me Cookie not found, call MyKeysight Login
        
        IsFormLoadedFromCookie = false;
        
        var strFirstName = "";
        var strLastName = "";
        var strEmailAddress = "";
        var strCountry = "";
        if (_eUF.getCookieVal('AK_COUNTRY').length) {
          strCountry = _eUF.getCookieVal('AK_COUNTRY');
        }

        if (_eUF.getCookieVal('AGREMMEADV').length && IsFormLoadedFromCookie == false && isCheckKcomCookies) {
          console.log("Cookie AGREMMEADV found : " + _eUF.getCookieVal('AGREMMEADV'));

          //window.clearTimeout(elqtimeoutHandle);

          var host = window.location.host;
          var strRememberMeAPIEndpoint = "https://"+host+"/etc/keysight/api/UpdateFormCookie"; 

          var strRememberMeCookieName = _eUF.getCookieVal('AGREMMEADV');
          strRememberMeAPIEndpoint += "?cookieValue="+strRememberMeCookieName;
          
          $.ajax({
            type: "GET",
            async: false,
            url: strRememberMeAPIEndpoint,
            success: function(response) { 
              console.log("SUCCESS : \n" + response.FirstGivenName + "|" + response.LastName + "|" + response.EmailAddress + " | " + strCountry );

              if (response.FirstGivenName) strFirstName = response.FirstGivenName.trim();
              if (response.LastName) strLastName = response.LastName.trim();
              if (response.EmailAddress) strEmailAddress = response.EmailAddress.trim();

              window.clearTimeout(elqtimeoutHandle);
              resetFormDisplay();
              if (strFirstName.length > 0 || strLastName.length > 0 || strEmailAddress.length > 0) {

                $('input[name="firstName"]').val(strFirstName);
                $('input[name="lastName"]').val(strLastName);
                $('input[name="emailAddress"]').val(strEmailAddress);
                $('select[name="country"]').val(strCountry);

                if ( ! checkAutoSubmit("AS-REMMECOOKIE") ) {
                  formState = 'S20';
                  setFormDisplay();				                
                } else {
                  IsFormLoadedFromCookie = true;
                }
              }
              else {
                console.log("RememberMeAPI returned empty");
              }
            },
            error: function(error) {
              console.log("RememberMeAPI Error :" + error);
            }
          });
          //To Do : Auto submit form when form is loaded
        } 
        
        if (_eUF.getCookieVal('AGRL').length && IsFormLoadedFromCookie == false && isCheckKcomCookies) {
          console.log("Cookie AGRL found : " + _eUF.getCookieVal('AGRL'));

          //window.clearTimeout(elqtimeoutHandle);

          var host = window.location.host;
          var strMyKUserAPIEndpoint = "https://"+host+"/etc/keysight/api/user-profile.json"; 

          $.ajax({
            type: "GET",
            async: false,
            url: strMyKUserAPIEndpoint,
            success: function(response) { 
              console.log("SUCCESS : \n" + response.first_name + " | " + response.last_name + " | " + response.email + " | " + strCountry );
              
              if (response.first_name) strFirstName = response.first_name.trim();
              if (response.last_name) strLastName = response.last_name.trim();
              if (response.email) strEmailAddress = response.email.trim();

              window.clearTimeout(elqtimeoutHandle);
              resetFormDisplay();
              if (strFirstName.length > 0 || strLastName.length > 0 || strEmailAddress.length > 0) {

                $('input[name="firstName"]').val(strFirstName);
                $('input[name="lastName"]').val(strLastName);
                $('input[name="emailAddress"]').val(strEmailAddress);
                $('select[name="country"]').val(strCountry);
                
                if ( ! checkAutoSubmit("AS-MYKCOOKIE") ) {
                  	formState = 'S20';
                  	setFormDisplay();				                
                } else {
                	IsFormLoadedFromCookie = true;
                }
              }
              else {
                console.log("MyKUserAPI returned empty");
              }
            },
            error: function(error) {
              console.log("MyKUserAPI Error :" + error);
            }
          });
          //To Do : Auto submit form when form is loaded
        } 
        
        if ( IsFormLoadedFromCookie == false) {
          formState = 'S00';
          setFormDisplay();
        } 

      }
  
  
      function setFormDisplay()
      {
        _edbg && console.log("FUNC CALLED : setFormDisplay()");
        _edbg && console.log("Entered setFormDisplay formState = " + formState);  
                
        if (formState == '' || formState == 'S00' ) {
            // Show email editable & continue without Change Email link
            showVisitorEmail();
        }
        else if (formState == 'S10' || formState == 'S20') {
            // Show email read only, form fields & Submit button with Change Email link
            showContactFields();
        }
        
        // To do : optimize
        $("#body_lookup").show();
      }
  
      function clearFormData() {
        _edbg && console.log("FUNC CALLED : clearFormData()");
        
        var visitorEmail = $("#field00").val(); 
        $("#frmELQ")[0].reset();
        $("#field00").val(visitorEmail);
      }
  
      function resetFormDisplay() {
        _edbg && console.log("FUNC CALLED : resetFormDisplay()");
  
        // Reset Form Display State
        $("#body_lookup").hide();
        
        $(".eloqua-spinner").addClass("eloqua-spinner-2");
        
        $("#elq-visitor-email").hide();     
        $("#main_body").hide();
  
        $("#outer_spn").hide();
        $("#field00").attr("readonly",false);
        $('.error-text').hide();
        
        //$("#epp1").show();
        //$("#epp2").show();
        //$("#epp4").show();
        $("div.field-row").show();
        
        //$("#epp12").show();
        //$('#field12').prop("checked", false);
        
        $("#btnContinue").hide();
        
        //$("#btnSubmitContact").hide().prop('disabled', true);
        $("#Submit_contact").hide().prop('disabled', true);
        
        clearFormData();
      }
  
      function loadElqContactData() {
        _edbg && console.log("FUNC CALLED : loadElqContactData()");
        // To Do : Hide EPP Divs for value received 
  
        lookup = true ; //To Do: Check at other locations 
        if ( lookup ) {
          if (GetElqContentPersonalizationValue("C_EmailAddress").length > 0 ) {
            $("#field00").val(GetElqContentPersonalizationValue("C_EmailAddress"));
            profileEmailElq = GetElqContentPersonalizationValue("C_EmailAddress");
          }
          if (GetElqContentPersonalizationValue("C_FirstName").length > 0 ) {
            $("#field01").val(GetElqContentPersonalizationValue("C_FirstName")).closest(".field-row").hide();
          }
          if (GetElqContentPersonalizationValue("C_LastName").length > 0 ) {
            $("#field02").val(GetElqContentPersonalizationValue("C_LastName")).closest(".field-row").hide();
          }
          if (GetElqContentPersonalizationValue("C_Country").length > 0 ) {
            // code updated: country code not mapped with drop down 
            //$("#field04").val(GetElqContentPersonalizationValue("C_Country")).closest(".field-row").hide();

            $("#field04").closest(".field-row").hide();
            $("#field04").val(GetElqContentPersonalizationValue("C_Country")); //set value received from Eloqua 
            //Check if country dropdown value is selected 
            if ( !$( "#field04 option:selected" ).val() ) {
              //set value based on dropdown display text  received from Eloqua 
              $("#field04 option").filter(function() {  return ($(this).text() == GetElqContentPersonalizationValue("C_Country")); }).prop('selected', true);
              
              //Check if country dropdown value is selected based on display text
              if ( !$( "#field04 option:selected" ).val() ) {
                $("#field04").closest(".field-row").show(); //show row for user to input
              }
            } 
          }      
          if ((GetElqContentPersonalizationValue("C_Email_Optin1") === "True" || GetElqContentPersonalizationValue("C_Email_Optin1") === "Yes") && 
              (GetElqContentPersonalizationValue("C_Privacy_Agreement_Opt_In1") === "True" || GetElqContentPersonalizationValue("C_Privacy_Agreement_Opt_In1") === "Yes")) {
                $("#field12").prop("checked", true).closest(".field-row").hide();
          }
  
          //checkAutoSubmit("AS-ELQLOAD");

          if ( ! checkAutoSubmit("AS-ELQLOAD") ) {
            //Do nothing
          }

          lookup = false;
        }
      }
      
      function checkAutoSubmit(formDataSource) {
        if ($("#field00").val().length > 0 && $("#field01").val().length > 0 && $("#field02").val().length > 0 && $("#field04").val().length > 0 ) {
          _edbg && console.log("Auto submit condition met and autoFormSubmit is " + autoFormSubmit);

          if (autoFormSubmit) {
            //To Do : Auto submit form when form is loaded
            //$('#frmELQ')[0].submit();
            
            window.clearTimeout(elqtimeoutHandle);
            $("#hidfield33").val($("#hidfield33").val()+"DataSource:"+formDataSource);
            $("#Submit_contact").prop('disabled', false).trigger('click');
            
            // call spinner
            checkGatedCookieUpdated(0);
            
            return true;
          }
        }

        return false;
      }
      
      function checkGatedCookieUpdated(checkCounter){
        if(checkCounter < 20){
          setTimeout(function(){
            checkCounter++;
            _edbg && console.log("Checking Gated Cookie -> Counter: "+checkCounter+"; URL:"+_eUF.getCookieVal("gated1"));
            if ( _eUF.getCookieVal("gated") == _eUF.getCleanUrl() ) {
              checkCounter = 1000;
              $("#ty_div").show()
              $("#form_body").hide(); 
              $(".eloqua-spinner").removeClass("eloqua-spinner-2");
              $("#body_lookup").show();
            }
            checkGatedCookieUpdated(checkCounter);
          }, 100);
        }
      }
  
