                        {{/if}}
                        {{#if howtobuy}}
                        <li><a class="dtmData" href={{howtobuy}} data-destUrl="{{howtobuy}}" data-name="" data-value="How To Buy" data-value-english="How To Buy" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
