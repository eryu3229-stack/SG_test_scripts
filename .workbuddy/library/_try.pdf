        //Common Utility Functions
        var _eUF = {
            getParameterByName:function (variable){ var query=window.location.search.substring(1); var vars=query.split("&"); for (var i=0; i < vars.length; i++){ var pair=vars[i].split("="); if (pair[0]==variable){ return pair[1];}} return (false);},
            createCookie:function (cookieName, cookieVal, exdays){ var d=new Date(); d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000)); var expires='expires=' + d.toUTCString(); document.cookie=cookieName + '=' + cookieVal + ';' + expires + ';domain=.keysight.com;path=/';},
            getCookieVal:function (cname){ var name=cname + "="; var decodedCookie=document.cookie; var ca=decodedCookie.split(';'); for (var i=0; i < ca.length; i++){ var c=ca[i]; while (c.charAt(0)==' '){ c=c.substring(1);} if (c.indexOf(name)==0){ return c.substring(name.length, c.length);}} return "";},
            getCleanUrl:function (){ return [location.protocol, '//', location.host, location.pathname].join('');}
        }
        var _eFURL = window.location.href; //FULL URL
      var _edbg = true; 
      if ((_eFURL.indexOf('?' + 'elqdbg=true') !== -1) || (_eFURL.indexOf('&' + 'elqdbg=true') !== -1)) { _edbg = true;}
      if ((_eFURL.indexOf('?' + 'elqdbg=false') !== -1) || (_eFURL.indexOf('&' + 'elqdbg=false') !== -1)) { _edbg = false;}
        
        
