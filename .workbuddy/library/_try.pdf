                            Technical Support</a>
                        </li>
                        {{/if}}
                    </ul>
                    {{/ifEquals}}

                    {{#ifEquals DOC_TYPE 'subcategory'}}
                    <ul class="products-List">
                        {{#if preVersionLink}}
                            <li><a class="dtmData" href="{{preVersionLink}}" data-destUrl="{{preVersionLink}}" data-name="" data-value="Previous Link" data-value-english="Previous Link" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                                Previous Version
                                </a>
                            </li>
                        {{/if}}
                        {{#if productpath}}
                            <li><a class="dtmData" href="{{productpath}}" data-destUrl="{{productpath}}" data-name="" data-value="Product Details" data-value-english="Product Details" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                                {{titleLabel}}
                                </a>
                            </li>
                        {{/if}}
                        {{#if howtobuy}}
                        <li><a class="dtmData" href={{howtobuy}} data-destUrl="{{howtobuy}}" data-name="" data-value="How To Buy" data-value-english="How To Buy" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                            How to Buy</a>
                        </li>
                        {{/if}}

                        {{#if optionAndUpgrade}}
                        <li><a class="dtmData" href={{optionAndUpgrade}} data-destUrl="{{optionAndUpgrade}}" data-name="" data-value="Options And Upgrade" data-value-english="Options And Upgrade" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                            Options and Upgrades</a>
                        </li> 
                        {{/if}} 
                        
                        {{#if techsupportLink}}
                        <li><a class="dtmData" href={{techsupportLink}} data-destUrl="{{techsupportLink}}" data-name="" data-value-english="Technical Support" data-value="Technical Support" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                            Technical Support</a>
                        </li>
                        {{/if}}
                    </ul>
                    {{/ifEquals}}

                    {{#ifEquals DOC_TYPE 'category'}}
                    <ul class="products-List">
                        {{#if preVersionLink}}
                            <li><a class="dtmData" href="{{preVersionLink}}" data-destUrl="{{preVersionLink}}" data-name="" data-value="Previous Link"  data-value-english="Previous Link" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                                Previous Version
                                </a>
                            </li>
                        {{/if}}
                        {{#if productpath}}
                            <li><a class="dtmData" href="{{productpath}}" data-destUrl="{{productpath}}" data-name="" data-value="Product Details"  data-value-english="Product Details" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                                {{titleLabel}}
                                </a>
