                                Previous Version
                                </a>
                            </li>
                        {{/if}}
                        {{#if productpath}}
                            <li><a class="dtmData" href="{{productpath}}" data-destUrl="{{productpath}}" data-value-english="Product Details"  data-parent-group="Matched contents" data-name="Matched Contents" data-value="Product Details" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                                {{titleLabel}}
                                </a>
                            </li>
                        {{/if}}
                        {{#if howtobuy}}
                        <li><a class="dtmData" href={{howtobuy}} data-destUrl="{{howtobuy}}" data-value-english="How To Buy"  data-name="Matched Contents" data-value="How To Buy" data-parent-group="Matched contents"  data-parentValue="{{productTitle}}">
                            How to Buy</a>
