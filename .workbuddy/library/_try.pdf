                    </div>
                    {{/if}}
                    <div class="productDetails">
                        
                    <div class="keysight-assets-content__wrapper--title"><a role="heading" aria-level="3" class="dtmData" href={{productpath}} data-destUrl="{{productpath}}" data-name="Search Results" data-value="{{productTitle}}" data-parent-value="{{productTitle}}" data-value-english="{{productTitle}}" data-parent-group="Matched contents" data-parentValue="Search">{{productTitle}}
                        {{#if itemStatus}}
                        <span>[</span><span>{{itemStatus}}</span><span>]</span>
                        {{/if}}
                    </a></div>
                    {{#ifEquals DOC_TYPE 'product'}}
                    <ul class="products-List">
                        {{#if preVersionLink}}
